<dialog class="sales-detail-modal" id="saleModal-<%= venta.id %>">
  <div class="sales-detail-head">
    <div>
      <span>Venta presencial</span>
      <h2><%= venta.codigo %></h2>
      <p><%= venta.creadoEn.toLocaleString('es-CR') %></p>
    </div>
    <button type="button" data-close-sale="<%= venta.id %>" aria-label="Cerrar">X</button>
  </div>

  <div class="sales-detail-grid">
    <section>
      <span>Cliente</span>
      <strong><%= venta.clienteNombre || 'Consumidor final' %></strong>
      <p>Correo: <%= venta.clienteCorreo || 'No indicado' %></p>
      <p>Cedula: <%= venta.clienteCedula || 'No indicada' %></p>
    </section>
    <section>
      <span>Pago</span>
      <strong><%= venta.metodoPago %></strong>
      <p>Total: <%= formatMoney(venta.total) %></p>
    </section>
    <section>
      <span>Vendedor</span>
      <strong><%= venta.vendedor.correo %></strong>
      <p>Comision: <%= formatMoney(venta.comision) %></p>
    </section>
  </div>

  <section class="sales-detail-block">
    <span>Productos vendidos</span>
    <div class="sales-detail-items">
      <% venta.items.forEach((item) => { const product = item.producto || {}; %>
        <div>
          <strong><%= product.nombre || `Producto #${item.productoId}` %></strong>
          <small>SKU: PRD-<%= String(item.productoId).padStart(4, '0') %></small>
          <small><%= product.categoria?.nombre || 'Sin categoria' %> / <%= product.subcategoria?.nombre || 'General' %></small>
          <span><%= item.cantidad %> x <%= formatMoney(item.precioUnitario) %></span>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="sales-detail-block">
    <span>Nota interna</span>
    <p><%= venta.notas || 'Sin nota registrada.' %></p>
  </section>

  <section class="sales-detail-block">
    <span>Comprobantes</span>
    <%- include('sale-proofs', { adjuntos: venta.adjuntos || [] }) %>
  </section>

  <div class="sales-detail-actions">
    <button class="btn" type="button" data-edit-sale="<%= venta.id %>">Editar venta</button>
  </div>

  <form class="sales-edit-form" method="POST" action="/admin/ventas/<%= venta.id %>?_method=PUT"
    enctype="multipart/form-data" data-sale-edit-form="<%= venta.id %>" hidden>
    <div class="sales-edit-head">
      <div><span>Correccion administrativa</span><h3>Editar datos y comprobantes</h3></div>
      <p>Los productos, cantidades y totales permanecen protegidos.</p>
    </div>
    <div class="sales-edit-grid">
      <label>Cliente<input name="clienteNombre" value="<%= venta.clienteNombre || '' %>" placeholder="Consumidor final"></label>
      <label>Correo<input type="email" name="clienteCorreo" value="<%= venta.clienteCorreo || '' %>" placeholder="cliente@correo.com"></label>
      <label>Cedula<input name="clienteCedula" value="<%= venta.clienteCedula || '' %>" placeholder="Identificacion"></label>
      <label>Metodo de pago<select name="metodoPago">
        <% ['EFECTIVO', 'SINPE', 'TARJETA', 'TRANSFERENCIA', 'OTRO'].forEach((method) => { %>
          <option value="<%= method %>" <%= venta.metodoPago === method ? 'selected' : '' %>><%= method %></option>
        <% }) %>
      </select></label>
      <label class="field-full">Nota interna (opcional)
        <textarea name="notas" rows="3"><%= venta.notas || '' %></textarea>
      </label>
      <label class="field-full sales-edit-files">Agregar factura o comprobante
        <input type="file" name="comprobantes" accept="image/*,.pdf" multiple>
        <small>Los archivos nuevos se agregan; los comprobantes anteriores se conservan.</small>
      </label>
    </div>
    <div class="form-actions">
      <button class="btn" type="submit">Guardar cambios</button>
      <button class="btn btn-outline" type="button" data-cancel-sale-edit="<%= venta.id %>">Cancelar</button>
    </div>
  </form>
</dialog>
