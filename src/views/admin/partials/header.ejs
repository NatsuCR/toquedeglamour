<% const visual = typeof siteSettings !== 'undefined' ? siteSettings : {}; %>
<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Toque de Glamour - Admin</title>
  <meta name="description" content="Panel de administracion de Toque de Glamour">
  <link rel="icon" href="/favicon.ico">
  <script>
    (function () {
      var theme = localStorage.getItem('theme');
      if (theme === 'dark' || theme === 'light') document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    html:not([data-theme="dark"]) {
      --primary: <%= visual.primaryColor || '#7b2446' %>;
      --primary-strong: <%= visual.primaryStrongColor || '#54172d' %>;
      --secondary: <%= visual.secondaryColor || '#c7964a' %>;
      --accent: <%= visual.accentColor || '#356d84' %>;
    }
  </style>
  <script src="/js/theme.js" defer></script>
</head>
<body>
  <% if (typeof admin !== 'undefined' && admin) { %>
    <div class="admin-layout animate__animated animate__fadeIn">
      <aside class="admin-sidebar">
        <div class="admin-brand">
          <% if (visual.logoUrl) { %>
            <img src="<%= visual.logoUrl %>" alt="Toque de Glamour" class="admin-logo">
          <% } else { %>
            <h2>Toque de Glamour</h2>
          <% } %>
          <span>Panel administrativo</span>
        </div>
        <div class="theme-row">
          <select id="themeSelector" class="theme-select form-control" aria-label="Tema visual">
            <option value="light">Claro</option>
            <option value="dark">Oscuro</option>
          </select>
        </div>
        <ul class="admin-nav">
          <li><a href="/admin/dashboard">Dashboard</a></li>
          <li><a href="/admin/finanzas">Finanzas</a></li>
          <li><a href="/admin/correos">Correos</a></li>
          <li><a href="/admin/marcas">Marcas</a></li>
          <li><a href="/admin/apariencia">Apariencia</a></li>
          <li><a href="/admin/pedidos">Pedidos</a></li>
          <li><a href="/admin/soporte">Soporte</a></li>
          <li><a href="/admin/usuarios">Usuarios</a></li>
          <li><a href="/admin/categorias">Categorías</a></li>
          <li><a href="/admin/productos">Productos</a></li>
          <li><a href="/admin/logout" class="btn-outline">Cerrar sesión</a></li>
        </ul>
      </aside>
      <main class="admin-main">
  <% } else { %>
    <main class="animate__animated animate__fadeIn" style="display:flex; justify-content:center; align-items:center; min-height:100vh;">
  <% } %>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const path = window.location.pathname;
      document.querySelectorAll('.admin-nav a').forEach((link) => {
        if (link.getAttribute('href') === path) link.classList.add('active');
      });
    });
  </script>
