<section id="categoryFormPanel" class="admin-form-panel is-hidden">
  <div class="form-panel-head">
    <div>
      <span>Categoría</span>
      <h2 id="formTitle">Crear categoría</h2>
      <p>Define una familia visible para ordenar productos.</p>
    </div>
    <button class="btn btn-outline" type="button" onclick="cerrarCategoriaForm()">Cerrar</button>
  </div>

  <form id="formPrincipal" method="POST" action="/admin/categorias">
    <div class="admin-form-grid one-column">
      <label>Nombre<input type="text" name="nombre" class="form-control" required></label>
      <label>Descripción<textarea name="descripcion" class="form-control" rows="3"></textarea></label>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn">Guardar categoría</button>
      <button type="button" class="btn btn-outline" onclick="cerrarCategoriaForm()">Cancelar</button>
    </div>
  </form>
</section>
