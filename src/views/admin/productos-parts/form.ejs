<section id="productFormPanel" class="admin-form-panel is-hidden">
  <div class="form-panel-head">
    <div>
      <span>Producto</span>
      <h2 id="formTitle">Crear producto</h2>
      <p>Completa la informacion comercial que vera el cliente.</p>
    </div>
    <button class="btn btn-outline" type="button" onclick="cerrarProductoForm()">Cerrar</button>
  </div>

  <form id="formPrincipal" method="POST" action="/admin/productos" enctype="multipart/form-data">
    <div class="admin-form-grid">
      <label>Nombre<input type="text" name="nombre" class="form-control" required></label>
      <label>Tipo de venta
        <select name="tipoVenta" id="tipoVentaSelect" class="form-control" required>
          <option value="DIRECTA">Venta directa</option>
          <option value="CONSULTA">Por consulta o cita</option>
        </select>
      </label>
      <label>Categoria<select name="categoriaId" id="categoriaSelect" class="form-control" required>
        <option value="">Selecciona una categoria</option>
        <% categorias.forEach((c) => { %><option value="<%= c.id %>"><%= c.nombre %></option><% }) %>
      </select></label>
      <label>Subcategoria<select name="subcategoriaId" id="subcategoriaSelect" class="form-control">
        <option value="">Sin subcategoria</option>
        <% categorias.forEach((c) => { (c.subcategorias || []).forEach((s) => { %>
          <option value="<%= s.id %>" data-categoria="<%= c.id %>"><%= c.nombre %> / <%= s.nombre %></option>
        <% }) }) %>
      </select></label>
      <label>Precio venta (CRC)<input id="precioInput" type="number" step="0.01" name="precio" class="form-control" required></label>
      <label>Costo (CRC)<input id="costoInput" type="number" step="0.01" name="costo" class="form-control" required></label>
      <label>Stock<input id="stockInput" type="number" name="stock" class="form-control" required></label>
      <label class="field-full">Descripcion<textarea name="descripcion" class="form-control" rows="3"></textarea></label>
    </div>

    <div id="consultaNotice" class="product-consult-notice" hidden>
      Este producto se mostrara sin precio y guiara al cliente a solicitar una consulta.
    </div>

    <label class="admin-file-field">
      <span>Imagen del producto <small id="imgHint" hidden>(opcional al editar)</small></span>
      <input type="file" name="imagen" id="imgInput" accept="image/jpeg, image/png, image/webp" required>
    </label>

    <label class="check-row">
      <input type="checkbox" name="esNuevo" id="checkNuevo">
      <span>Marcar como nuevo <small>Aparece en "Recien llegados" por 30 dias.</small></span>
    </label>

    <div class="form-actions">
      <button type="submit" class="btn">Guardar producto</button>
      <button type="button" class="btn btn-outline" onclick="cerrarProductoForm()">Cancelar</button>
    </div>
  </form>
</section>
