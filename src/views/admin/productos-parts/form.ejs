<section id="productFormPanel" class="admin-modal-shell is-hidden" role="dialog" aria-modal="true">
  <div class="admin-modal-backdrop" onclick="cerrarProductoForm()"></div>
  <div class="admin-modal-card admin-modal-card-lg">
    <div class="form-panel-head">
      <div>
        <span>Producto</span>
        <h2 id="formTitle">Crear producto</h2>
        <p>Completa la información comercial que verá el cliente.</p>
      </div>
      <button class="admin-modal-close" type="button" onclick="cerrarProductoForm()" aria-label="Cerrar">X</button>
    </div>

    <form id="formPrincipal" method="POST" action="/admin/productos" enctype="multipart/form-data">
      <div class="admin-form-grid">
        <label>Nombre<input type="text" name="nombre" class="form-control" required></label>
        <label>Marca<input type="text" name="marca" class="form-control" placeholder="Ej. Farmasi"></label>
        <label>Tipo de venta<select name="tipoVenta" id="tipoVentaSelect" class="form-control" required>
          <option value="DIRECTA">Venta directa</option>
          <option value="CONSULTA">Por consulta o cita</option>
        </select></label>
        <label id="tipoProductoField" data-direct-field>Tipo de producto
          <select name="tipoProducto" id="tipoProductoSelect" class="form-control" required>
            <option value="GENERAL">Producto general</option>
            <option value="COSMETICO">Cosmético</option>
          </select>
        </label>
        <label>Categoría<select name="categoriaId" id="categoriaSelect" class="form-control" required>
          <option value="">Selecciona una categoría</option>
          <% categorias.forEach((c) => { %><option value="<%= c.id %>"><%= c.nombre %></option><% }) %>
        </select></label>
        <label>Subcategoría<select name="subcategoriaId" id="subcategoriaSelect" class="form-control">
          <option value="">Sin subcategoría</option>
          <% categorias.forEach((c) => { (c.subcategorias || []).forEach((s) => { %>
            <option value="<%= s.id %>" data-categoria="<%= c.id %>"><%= c.nombre %> / <%= s.nombre %></option>
          <% }) }) %>
        </select></label>
        <label data-direct-field>Precio venta (CRC)<input id="precioInput" type="number" step="0.01" name="precio" class="form-control" min="0" required></label>
        <label data-direct-field>Costo (CRC)<input id="costoInput" type="number" step="0.01" name="costo" class="form-control" min="0" required></label>
        <label data-direct-field>Peso del producto en gramos<input id="pesoInput" type="number" name="pesoGramos" class="form-control" min="1" step="1" required></label>
        <label class="field-full" data-direct-field>Stock<input id="stockInput" type="number" name="stock" class="form-control" min="0" required></label>
      </div>

      <%- include('content-fields') %>

      <div id="consultaNotice" class="product-consult-notice" hidden>
        Este producto se mostrará sin precio y guiará al cliente a solicitar una consulta.
      </div>

      <section id="existingProductImages" class="product-existing-images" hidden>
        <div>
          <strong>Imágenes actuales</strong>
          <small>Conservan este orden. Marca solo las que deseas quitar.</small>
        </div>
        <div id="existingProductImagesGrid" class="product-existing-grid"></div>
      </section>

      <label class="admin-file-field product-upload-field">
        <span class="product-upload-heading">
          <span class="product-upload-icon" aria-hidden="true">+</span>
          <span>
            <strong>Agregar imágenes</strong>
            <small id="imgHint" hidden>Opcional al editar</small>
          </span>
        </span>
        <input type="file" name="imagenes" id="imgInput" accept="image/jpeg, image/png, image/webp" multiple required>
        <small>JPG, PNG o WebP. Al crear, la primera será la principal; al editar, se agregarán al final.</small>
      </label>
      <p id="productImageSelectionStatus" class="product-upload-status" aria-live="polite"></p>
      <div id="newProductImagesPreview" class="product-new-images" aria-live="polite"></div>

      <label class="check-row product-feature-toggle">
        <input type="checkbox" name="esNuevo" id="checkNuevo">
        <span class="product-feature-check" aria-hidden="true"></span>
        <span>Marcar como nuevo <small>Aparece en "Recién llegados" por 30 días.</small></span>
      </label>

      <div class="form-actions">
        <button type="submit" class="btn">Guardar producto</button>
        <button type="button" class="btn btn-outline" onclick="cerrarProductoForm()">Cancelar</button>
      </div>
    </form>
  </div>
</section>
