<div class="product-promotion-fields" data-promotion-field>
  <label class="check-row">
    <input type="checkbox" name="promocionActiva" id="productPromotionActive">
    <span>Mostrar promoción en las tarjetas del producto</span>
  </label>
  <label>Descuento promocional (%)
    <input type="number" name="promocionPorcentaje" min="0" max="90" step="1" value="0" class="form-control">
  </label>
</div>
