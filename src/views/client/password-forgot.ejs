<%- include('partials/header') %>

<section class="settings-page">
  <header class="settings-hero">
    <span>Acceso</span>
    <h1>Recuperar contraseña</h1>
    <p>Escribe el correo de tu cuenta y te enviaremos un codigo de seguridad.</p>
  </header>

  <% if (error) { %><div class="checkout-alert"><%= error %></div><% } %>
  <% if (success) { %><div class="settings-success"><%= success %></div><% } %>

  <form class="settings-panel settings-narrow" method="POST" action="/password/olvido">
    <label>Correo electronico
      <input type="email" name="correo" required placeholder="tu@correo.com">
    </label>
    <button class="nav-btn" type="submit">Enviar codigo</button>
    <a class="btn-outline" href="/login">Volver al login</a>
  </form>
</section>

<%- include('partials/footer') %>
