<%
  const fases = pedido.tipoEntrega === 'LOCAL'
    ? ['PREPARACION', 'LISTO', 'COMPLETADO']
    : ['PREPARACION', 'LISTO', 'ENVIADO', 'COMPLETADO'];
  const faseActual = Math.max(0, fases.indexOf(pedido.fase || 'PREPARACION'));
  const cancelado = pedido.estado === 'RECHAZADO';
%>

<article class="order-card">
  <div class="order-head">
    <div>
      <span>Pedido</span>
      <h2><%= pedido.codigo || `#${pedido.id}` %></h2>
      <p><%= pedido.creadoEn.toLocaleDateString('es-CR') %></p>
    </div>
    <div>
      <span class="badge-soft"><%= estadoLabels[pedido.estado] || pedido.estado %></span>
      <strong><%= formatMoney(pedido.total) %></strong>
    </div>
  </div>

  <% if (cancelado) { %>
    <div class="order-cancel-notice">
      <strong>Pedido cancelado</strong>
      <p><%= pedido.motivoCancelacion || 'Administracion cancelo este pedido.' %></p>
    </div>
  <% } else { %>
    <div class="phase-track">
      <% fases.forEach((fase, index) => { %>
        <span class="phase-step <%= index <= faseActual ? 'done' : '' %>"><%= faseLabels[fase] %></span>
      <% }) %>
    </div>
  <% } %>

  <div class="mini-items">
    <% pedido.items.slice(0, 2).forEach((item) => { %>
      <div class="mini-item">
        <span><%= item.cantidad %> x <%= item.producto.nombre %></span>
        <strong><%= formatMoney(Number(item.precioUnitario) * item.cantidad) %></strong>
      </div>
    <% }) %>
    <% if (pedido.items.length > 2) { %>
      <p class="order-more-count">+ <%= pedido.items.length - 2 %> productos mas en el detalle.</p>
    <% } %>
  </div>

  <div class="order-meta">
    <p><span>Entrega</span><strong><%= pedido.tipoEntrega === 'DOMICILIO' ? 'Correos de Costa Rica' : 'Retiro en local' %></strong></p>
    <p><span>Comprobante</span><strong><%= pedido.comprobantePago ? 'Recibido' : 'Pendiente' %></strong></p>
  </div>

  <details class="order-details">
    <summary>
      <span class="detail-show">Ver mas informacion</span>
      <span class="detail-hide">Ocultar informacion</span>
    </summary>
    <%- include('./order-detail', { pedido, user }) %>
  </details>
</article>
