<% const faseLabels = { PREPARACION: 'Preparacion del pedido', LISTO: 'Pedido listo', ENVIADO: 'Pedido enviado', COMPLETADO: 'Completado' }; %>
<% const estadoLabels = { PENDIENTE_VERIFICACION: 'Pago en revision', PAGO_CONFIRMADO: 'Pago confirmado', EN_PREPARACION: 'En preparacion', ENVIADO: 'Enviado', ENTREGADO: 'Entregado', RECHAZADO: 'Cancelado' }; %>

<% if (!pedidos || pedidos.length === 0) { %>
  <div class="order-card order-empty-card">
    <span>Sin compras</span>
    <h2>Aun no tienes compras</h2>
    <p>Cuando confirmes un pedido, aparecera aqui para darle seguimiento.</p>
    <a class="nav-btn" href="/catalogo">Ir al catalogo</a>
  </div>
<% } else { %>
  <div class="order-list">
    <% pedidos.forEach((pedido) => { %>
      <%- include('./order-card', { pedido, user, faseLabels, estadoLabels }) %>
    <% }) %>
  </div>
<% } %>
