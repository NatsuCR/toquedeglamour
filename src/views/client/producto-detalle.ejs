<%- include('partials/header') %>

<%
  const consulta = producto.tipoVenta === 'CONSULTA';
  const categoria = producto.subcategoria?.nombre || producto.categoria?.nombre || 'General';
  const sku = `PRD-${producto.id.toString().padStart(4, '0')}`;
  const marcaConsulta = producto.marca ? ` de la marca ${producto.marca}` : '';
  const consultaTexto = `Hola, quiero consultar precio y detalles del producto ${producto.nombre}${marcaConsulta} (${sku}).`;
  const consultaWhatsapp = `https://wa.me/50685203998?text=${encodeURIComponent(consultaTexto)}`;
  const imagenesProducto = Array.isArray(producto.imagenes) && producto.imagenes.length
    ? producto.imagenes
    : (producto.imagenUrl ? [{ ruta: producto.imagenUrl }] : []);
%>

<section class="product-detail animate__animated animate__fadeIn">
  <div class="product-detail-media">
    <% if (imagenesProducto.length) { %>
      <div class="product-gallery-stage" data-product-stage>
        <button
          type="button"
          class="product-main-image"
          data-product-main
          data-lightbox-src="<%= imagenesProducto[0].ruta %>"
          data-lightbox-alt="<%= producto.nombre %>"
          aria-label="Ampliar imagen de <%= producto.nombre %>"
        >
          <img src="<%= imagenesProducto[0].ruta %>" alt="<%= producto.nombre %>" data-product-main-img>
          <span>Ampliar</span>
        </button>

        <% if (imagenesProducto.length > 1) { %>
          <button class="product-gallery-arrow is-prev" type="button" data-product-prev aria-label="Imagen anterior">&#8249;</button>
          <button class="product-gallery-arrow is-next" type="button" data-product-next aria-label="Imagen siguiente">&#8250;</button>
        <% } %>
      </div>

      <% if (imagenesProducto.length > 1) { %>
        <div class="product-thumbs <%= imagenesProducto.length > 6 ? 'is-scrollable' : '' %>" aria-label="Imágenes del producto">
          <% imagenesProducto.forEach((img, index) => { %>
            <button
              type="button"
              class="<%= index === 0 ? 'is-active' : '' %>"
              data-product-thumb="<%= img.ruta %>"
              aria-label="Ver imagen <%= index + 1 %> de <%= producto.nombre %>"
            >
              <img src="<%= img.ruta %>" alt="<%= producto.nombre %> <%= index + 1 %>">
            </button>
          <% }) %>
        </div>
      <% } %>
    <% } else { %>
      <div class="product-detail-empty">Sin imagen</div>
    <% } %>
  </div>

  <article class="product-detail-info">
    <% if (producto.marca) { %><span class="product-brand"><%= producto.marca %></span><% } %>
    <span class="card-category"><%= categoria %></span>
    <p class="product-sku">SKU: <%= sku %></p>
    <% if (!consulta) { %><p class="product-sku">Peso: <%= producto.pesoGramos || 250 %> g</p><% } %>
    <h1><%= producto.nombre %></h1>

    <div class="product-detail-price">
      <%= consulta ? 'Precio a consultar' : formatMoney(Number(producto.precio || 0)) %>
    </div>

    <%- include('producto-parts/content', { producto, consulta }) %>

    <div class="product-detail-action">
      <% if (consulta) { %>
        <div class="consult-box">
          Este articulo se coordina por consulta para definir detalles, medidas, tiempo de entrega y precio final.
        </div>
        <a class="whatsapp-consult-btn" href="<%= consultaWhatsapp %>" target="_blank" rel="noopener">
          <span class="whatsapp-consult-icon" aria-hidden="true">WA</span>
          Solicitar consulta por WhatsApp
        </a>
      <% } else if (producto.stock > 0) { %>
        <p class="stock-ok-text">En stock (<%= producto.stock %> disponibles)</p>
        <form method="POST" action="/carrito/agregar" class="product-cart-form">
          <input type="hidden" name="productoId" value="<%= producto.id %>">
          <input type="number" name="cantidad" value="1" min="1" max="<%= producto.stock %>" class="form-control" required>
          <button type="submit" class="nav-btn">Anadir al carrito</button>
        </form>
      <% } else { %>
        <div class="product-unavailable">Producto agotado temporalmente</div>
      <% } %>
    </div>
  </article>
</section>

<script src="/js/image-lightbox.js"></script>
<script src="/js/product-gallery.js"></script>

<%- include('partials/footer') %>
