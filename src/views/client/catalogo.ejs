<!-- src/views/client/catalogo.ejs -->
<%- include('partials/header') %>

<%
  const totalProductos = productos?.length || 0;
  const filtrosActivos = [
    filtros.q,
    filtros.cat,
    filtros.subcat,
    filtros.marca,
    filtros.minPrecio,
    filtros.maxPrecio,
    filtros.sort,
    filtros.disponible,
    filtros.consulta,
    filtros.promocion
  ].filter(Boolean).length;
  const categoriaActual = categorias.find((c) => c.slug === filtros.cat);
  const subcategoriaActual = categorias
    .flatMap((c) => c.subcategorias || [])
    .find((s) => s.slug === filtros.subcat);
  const marcaActual = filtros.marca || 'Todas';
%>

<section class="catalog-page animate__animated animate__fadeIn">
  <header class="catalog-hero">
    <div>
      <span>Tienda online</span>
      <h1>Cat&aacute;logo de productos</h1>
      <p>Explora maquillaje, cuidado personal y bienestar seleccionado para comprar con calma y claridad.</p>
    </div>
    <div class="catalog-summary">
      <article><span>Productos</span><strong><%= totalProductos %></strong></article>
      <article><span>Categor&iacute;a</span><strong><%= categoriaActual?.nombre || 'Todas' %></strong></article>
      <article><span>Subcategor&iacute;a</span><strong><%= subcategoriaActual?.nombre || 'Todas' %></strong></article>
      <article><span>Marca</span><strong><%= marcaActual %></strong></article>
    </div>
  </header>

  <div class="catalog-layout">
    <form class="catalog-mobile-search" action="/catalogo" method="GET">
      <label for="catalogMobileSearch">Buscar productos</label>
      <div>
        <input
          id="catalogMobileSearch"
          type="search"
          name="q"
          value="<%= filtros.q || '' %>"
          placeholder="Nombre o SKU"
        >
        <button type="submit">Buscar</button>
      </div>
    </form>
    <button
      class="catalog-filter-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="catalogFilter"
      data-catalog-filter-toggle>
      <span>Aplicar filtros</span>
      <% if (filtrosActivos) { %><strong><%= filtrosActivos %></strong><% } %>
    </button>

    <%- include('catalogo-parts/filter', { categorias, marcas, filtros }) %>

    <section class="catalog-results">
      <div class="catalog-results-head">
        <div>
          <span>Inventario</span>
          <h2>Productos disponibles</h2>
        </div>
        <p><%= totalProductos %> resultado<%= totalProductos === 1 ? '' : 's' %></p>
      </div>

      <%- include('catalogo-parts/product-grid', { productos }) %>
    </section>
  </div>
</section>

<script src="/js/catalog-load-more.js"></script>
<script src="/js/catalog-mobile-filter.js"></script>
<script src="/js/catalog-filter-options.js?v=20260816-2"></script>
<script src="/js/product-card-images.js?v=20260816-2"></script>

<%- include('partials/footer') %>
