<!-- src/views/client/ubicacion.ejs -->
<%- include('partials/header') %>

<div class="animate__animated animate__fadeIn" style="max-width: 1000px; margin: 0 auto; background: var(--surface); border-radius: 24px; padding: 4rem 3rem; border: 1px solid var(--glass-border); box-shadow: 0 10px 40px rgba(0,0,0,0.05); display: flex; flex-wrap: wrap; gap: 3rem;">
  
  <div style="flex: 1; min-width: 300px;">
    <h1 style="font-family: 'Playfair Display', serif; font-size: 2.5rem; margin-bottom: 1rem; color: var(--primary);">Nuestra Ubicación</h1>
    <p style="font-size: 1.1rem; color: var(--text-muted); margin-bottom: 2rem;">Ven y descubre todos nuestros productos en persona. Te asesoramos con mucho gusto.</p>
    
    <div style="background: rgba(255,255,255,0.6); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--glass-border); margin-bottom: 2rem;">
      <h3 style="margin-bottom: 0.5rem; color: var(--text-main);">Dirección Física</h3>
      <p style="font-size: 1.1rem; color: var(--text-muted);">
        <strong>Provincia:</strong> Alajuela<br>
        <strong>Cantón:</strong> San Carlos<br>
        <strong>Distrito:</strong> Muelle de San Carlos
      </p>
    </div>
    
    <div style="background: rgba(255,255,255,0.6); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--glass-border);">
      <h3 style="margin-bottom: 0.5rem; color: var(--text-main);">Horario de Atención</h3>
      <ul style="list-style: none; color: var(--text-muted); line-height: 1.8;">
        <li>Lunes a Viernes: 9:00 AM - 6:00 PM</li>
        <li>Sábados: 9:00 AM - 4:00 PM</li>
        <li>Domingos: Cerrado</li>
      </ul>
    </div>
  </div>

  <div style="flex: 1; min-width: 300px; border-radius: 16px; overflow: hidden; box-shadow: 0 5px 20px rgba(0,0,0,0.1);">
    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d301.71980466532676!2d-84.45936536916554!3d10.475791460719433!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fa07144f2f0f5c1%3A0xeef6392d35986cc4!2stoquedeglamour!5e1!3m2!1ses-419!2scr!4v1783038041259!5m2!1ses-419!2scr" width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </div>

</div>

<%- include('partials/footer') %>
