<%- include('partials/header') %>

<section class="auth-shell animate__animated animate__fadeIn">
  <article class="auth-card">
    <header class="auth-head">
      <span>Tu cuenta</span>
      <h1>Bienvenido</h1>
      <p>Inicia sesi&oacute;n para acceder a tus pedidos y beneficios.</p>
    </header>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="auth-alert is-error"><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="auth-alert is-success"><%= success %></div>
    <% } %>

    <form method="POST" action="/login" class="auth-form">
      <label>
        Correo electr&oacute;nico
        <input type="email" name="correo" required autocomplete="email" placeholder="tu@correo.com">
      </label>
      <label>
        Contrase&ntilde;a
        <input type="password" name="password" required autocomplete="current-password" placeholder="Tu contraseña">
      </label>
      <a href="/password/olvido" class="auth-help">&iquest;Olvidaste la contrase&ntilde;a?</a>
      <button type="submit" class="nav-btn auth-submit">Iniciar sesi&oacute;n</button>
    </form>

    <footer class="auth-footer">
      <span>&iquest;No tienes una cuenta?</span>
      <a href="/registro">Crear cuenta</a>
    </footer>
  </article>
</section>

<%- include('partials/footer') %>
