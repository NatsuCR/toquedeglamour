<% const visual = typeof siteSettings !== 'undefined' ? siteSettings : {}; %>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <% const pageTitle = typeof title !== 'undefined' ? `${title} - Toque de Glamour` : 'Toque de Glamour | Cosméticos y belleza'; %>
  <% const pageDescription = typeof metaDescription !== 'undefined' ? metaDescription : 'Cosméticos, maquillaje, salud, decoración y bienestar con envíos en Costa Rica.'; %>
  <% const canonicalUrl = `${siteUrl || ''}${typeof canonical !== 'undefined' ? canonical : canonicalPath || '/'}`; %>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDescription %>">
  <meta name="robots" content="<%= typeof robots !== 'undefined' ? robots : 'index, follow' %>">
  <link rel="canonical" href="<%= canonicalUrl %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDescription %>">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta property="og:type" content="website">
  <link rel="icon" href="/favicon.ico">
  <script>
    (function () {
      var theme = localStorage.getItem('theme');
      if (theme === 'dark' || theme === 'light') document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <link rel="stylesheet" href="/css/public.css">
  <style>
    html:not([data-theme="dark"]) {
      --primary: <%= visual.primaryColor || '#7b2446' %>;
      --primary-strong: <%= visual.primaryStrongColor || '#54172d' %>;
      --secondary: <%= visual.secondaryColor || '#c7964a' %>;
      --accent: <%= visual.accentColor || '#6f8f78' %>;
    }
  </style>
  <script src="/js/theme.js" defer></script>
  <script src="/js/public-nav.js" defer></script>
  <script src="/js/catalog-menu-flyout.js" defer></script>
  <script src="/js/site-analytics.js" defer></script>
</head>
<body>
  <nav class="public-nav animate__animated animate__fadeInDown">
    <%- include('navbar', { visual }) %>
  </nav>
  <main class="public-main">
