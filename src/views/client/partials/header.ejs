<% const visual = typeof siteSettings !== 'undefined' ? siteSettings : {}; %>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%- include('google-tag-manager-head', { gtmId }) %>
  <% const pageTitle = typeof title !== 'undefined' ? `${title} | Toque de Glamour` : 'Toque de Glamour | Cosméticos, salud, hogar y belleza'; %>
  <% const pageDescription = typeof metaDescription !== 'undefined' ? metaDescription : 'Cosméticos, maquillaje, salud, nutrición, hogar y belleza con entregas en Costa Rica.'; %>
  <% const canonicalUrl = `${siteUrl || ''}${typeof canonical !== 'undefined' ? canonical : canonicalPath || '/'}`; %>
  <% const imagePath = typeof metaImage !== 'undefined' && metaImage ? metaImage : visual.heroImageUrl || visual.logoUrl || '/img/toque-de-glamour.png'; %>
  <% const socialImage = /^https?:\/\//.test(imagePath) ? imagePath : `${siteUrl || ''}${imagePath}`; %>
  <title><%= pageTitle %></title>
  <%- include('seo-meta', {
    pageTitle, pageDescription, canonicalUrl, socialImage, visual, siteUrl,
    robots: typeof robots !== 'undefined' ? robots : undefined,
    metaType: typeof metaType !== 'undefined' ? metaType : undefined,
    seoKeywords: typeof seoKeywords !== 'undefined' ? seoKeywords : undefined,
    seoProduct: typeof seoProduct !== 'undefined' ? seoProduct : undefined,
    seoBrands: typeof seoBrands !== 'undefined' ? seoBrands : []
  }) %>
  <link rel="icon" href="/favicon.ico">
  <script>
    (function () {
      var theme = localStorage.getItem('theme');
      if (theme === 'dark' || theme === 'light') document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <link rel="stylesheet" href="/css/public.css?v=20260816-2">
  <style>
    html:not([data-theme="dark"]) {
      --primary: <%= visual.primaryColor || '#7b2446' %>;
      --primary-strong: <%= visual.primaryStrongColor || '#54172d' %>;
      --secondary: <%= visual.secondaryColor || '#c7964a' %>;
      --accent: <%= visual.accentColor || '#6f8f78' %>;
    }
  </style>
  <script src="/js/theme.js" defer></script>
  <script src="/js/public-nav.js" defer></script>
  <script src="/js/promotion-banners.js" defer></script>
  <script src="/js/catalog-menu-flyout.js" defer></script>
  <script src="/js/site-analytics.js" defer></script>


  <script type="text/javascript">
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", "xyeu197ffd");
</script>

</head>
<body>
  <%- include('google-tag-manager-body', { gtmId }) %>
  <nav class="public-nav animate__animated animate__fadeInDown">
    <%- include('navbar', { visual }) %>
  </nav>
  <%- include('promotion-banners') %>
