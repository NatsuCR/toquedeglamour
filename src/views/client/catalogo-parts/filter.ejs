<aside class="catalog-filter" id="catalogFilter" data-catalog-filter>
  <div class="catalog-filter-head">
    <span class="catalog-filter-kicker"><i aria-hidden="true">✦</i> B&uacute;squeda inteligente</span>
    <h2>Filtros</h2>
    <p>Encontr&aacute; tu producto ideal por nombre, marca, categor&iacute;a, precio o tipo de atenci&oacute;n.</p>
  </div>

  <form id="catalogFilterForm" action="/catalogo" method="GET">
    <label class="catalog-field">Buscar
      <input
        class="catalog-control"
        type="text"
        name="q"
        value="<%= filtros.q || '' %>"
        placeholder="Nombre o SKU (ej. PRD-0009)"
      >
    </label>

    <label class="catalog-field">Marca
      <select class="catalog-control" name="marca">
        <option value="">Todas</option>
        <% (marcas || []).forEach((marca) => { %>
          <option value="<%= marca %>" <%= filtros.marca === marca ? 'selected' : '' %>><%= marca %></option>
        <% }) %>
      </select>
    </label>

    <label class="catalog-field">Categor&iacute;a
      <select class="catalog-control" name="cat">
        <option value="">Todas</option>
        <% categorias.forEach((c) => { %>
          <option value="<%= c.slug %>" <%= filtros.cat === c.slug ? 'selected' : '' %>><%= c.nombre %></option>
        <% }) %>
      </select>
    </label>

    <label class="catalog-field">Subcategoria
      <select class="catalog-control" name="subcat">
        <option value="">Todas</option>
        <% categorias.forEach((c) => { if ((c.subcategorias || []).length) { %>
          <optgroup label="<%= c.nombre %>">
            <% c.subcategorias.forEach((s) => { %>
              <option value="<%= s.slug %>" <%= filtros.subcat === s.slug ? 'selected' : '' %>><%= s.nombre %></option>
            <% }) %>
          </optgroup>
        <% } }) %>
      </select>
    </label>

    <div class="catalog-field">
      <span>Rango de precio</span>
      <div class="catalog-price-row">
        <input class="catalog-control" type="number" name="minPrecio" value="<%= filtros.minPrecio || '' %>" placeholder="Min" min="0" step="5">
        <input class="catalog-control" type="number" name="maxPrecio" value="<%= filtros.maxPrecio || '' %>" placeholder="Max" min="0" step="5">
      </div>
    </div>

    <label class="catalog-field">Ordenar
      <select class="catalog-control" name="sort">
        <option value="">Relevancia</option>
        <option value="asc" <%= filtros.sort === 'asc' ? 'selected' : '' %>>Precio: menor a mayor</option>
        <option value="desc" <%= filtros.sort === 'desc' ? 'selected' : '' %>>Precio: mayor a menor</option>
      </select>
    </label>

    <div class="catalog-filter-options" aria-label="Tipo de producto">
      <label class="catalog-filter-option is-stock">
        <input type="checkbox" name="disponible" value="true" <%= filtros.disponible ? 'checked' : '' %> data-stock-filter>
        <span><strong>Solo productos en stock</strong><small>Disponibles para compra inmediata</small></span>
      </label>
      <label class="catalog-filter-option is-consult">
        <input type="checkbox" name="consulta" value="true" <%= filtros.consulta ? 'checked' : '' %> data-consult-filter>
        <span><strong>Solo productos de consulta</strong><small>Art&iacute;culos personalizados o por cotizar</small></span>
      </label>
      <label class="catalog-filter-option is-promotion">
        <input type="checkbox" name="promocion" value="true" <%= filtros.promocion ? 'checked' : '' %> data-promotion-filter>
        <span><strong>Solo productos en promoción</strong><small>Descuentos especiales activos</small></span>
      </label>
    </div>

    <div class="catalog-filter-actions">
      <button type="submit" class="nav-btn">Aplicar filtros</button>
      <a href="/catalogo" class="btn-outline">Limpiar</a>
    </div>
  </form>
</aside>
