<!-- src/views/client/carrito.ejs -->
<%- include('partials/header') %>

<% const totalItems = (carrito || []).reduce((sum, item) => sum + Number(item.cantidad || 0), 0); %>

<section class="cart-page animate__animated animate__fadeIn">
  <header class="cart-hero">
    <div>
      <span>Compra segura</span>
      <h1>Tu carrito</h1>
      <p>Revisa cantidades, impuestos y el resumen antes de continuar al pago final.</p>
    </div>
    <div class="cart-hero-badge">
      <span>Articulos</span>
      <strong><%= totalItems %></strong>
    </div>
  </header>

  <% if (!carrito || carrito.length === 0) { %>
    <section class="cart-empty">
      <span>Carrito vacio</span>
      <h2>Aun no agregaste productos</h2>
      <p>Explora el catalogo y elige tus favoritos para comenzar tu pedido.</p>
      <a href="/catalogo" class="nav-btn">Ver catalogo</a>
    </section>
  <% } else { %>
    <div class="cart-layout">
      <%- include('carrito-parts/items', { carrito }) %>
      <%- include('carrito-parts/summary', { subtotal, iva, total, finance }) %>
    </div>
  <% } %>
</section>

<%- include('partials/footer') %>
