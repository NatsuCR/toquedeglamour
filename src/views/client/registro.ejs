<%- include('partials/header') %>

<section class="auth-shell auth-register-shell animate__animated animate__fadeIn">
  <article class="auth-card auth-register-card">
    <header class="auth-head">
      <span>Nueva cuenta</span>
      <h1>Crea tu cuenta</h1>
      <p>Completa tus datos para comprar y dar seguimiento a tus pedidos.</p>
    </header>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="auth-alert is-error"><%= error %></div>
    <% } %>

    <form method="POST" action="/registro" class="auth-form">
      <div class="auth-fields">
        <label>Nombre<input type="text" name="nombre" required autocomplete="given-name" placeholder="Tu nombre"></label>
        <label>Apellidos<input type="text" name="apellidos" required autocomplete="family-name" placeholder="Tus apellidos"></label>
        <label>C&eacute;dula<input type="text" name="cedula" required inputmode="numeric" placeholder="Número de identificación"></label>
        <label>Celular<input type="tel" name="celular1" required autocomplete="tel" placeholder="Tu número de teléfono"></label>
        <label>Celular 2 <small>Opcional</small><input type="tel" name="celular2" placeholder="Otro número de contacto"></label>
        <label>Correo electr&oacute;nico<input type="email" name="correo" required autocomplete="email" placeholder="tu@correo.com"></label>
        <label class="auth-field-wide">Contrase&ntilde;a<input type="password" name="password" required autocomplete="new-password" placeholder="Crea una contraseña segura"></label>
      </div>

      <label class="terms-check">
        <input type="checkbox" name="aceptoTerminos" required>
        <span>Acepto los <a href="/terminos-condiciones" target="_blank">T&eacute;rminos y condiciones</a>
          y la <a href="/politica-privacidad" target="_blank">Pol&iacute;tica de privacidad</a>.
          <small>Usaremos tus datos para gestionar cuenta, pedidos, entregas y soporte.</small>
        </span>
      </label>

      <label class="terms-check">
        <input type="checkbox" name="aceptaPromociones">
        <span>Deseo recibir promociones y novedades por correo electr&oacute;nico.
          <small>Podr&aacute;s cambiar esta preferencia desde tu perfil.</small>
        </span>
      </label>
      <button type="submit" class="nav-btn auth-submit">Completar registro</button>
    </form>

    <footer class="auth-footer">
      <span>&iquest;Ya tienes una cuenta?</span>
      <a href="/login">Iniciar sesi&oacute;n</a>
    </footer>
  </article>
</section>

<%- include('partials/footer') %>
