<%- include('partials/header') %>

<section class="settings-page">
  <header class="settings-hero">
    <span>Acceso</span>
    <h1>Nueva contraseña</h1>
    <p>Ingresa el codigo enviado a <strong><%= correo %></strong>.</p>
  </header>

  <% if (error) { %><div class="checkout-alert"><%= error %></div><% } %>
  <% if (success) { %><div class="settings-success"><%= success %></div><% } %>

  <form class="settings-panel settings-narrow" method="POST" action="/password/restablecer">
    <label>Correo de la cuenta
      <input type="email" name="correo" required value="<%= correo %>">
    </label>
    <label>Codigo
      <input type="text" name="codigo" required inputmode="numeric" maxlength="6">
    </label>
    <label>Nueva contraseña
      <input type="password" name="password" required minlength="6">
    </label>
    <button class="nav-btn" type="submit">Cambiar contraseña</button>
    <a class="btn-outline" href="/password/olvido">Enviar otro codigo</a>
  </form>
</section>

<%- include('partials/footer') %>
