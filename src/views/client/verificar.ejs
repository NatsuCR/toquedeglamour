<%- include('partials/header') %>

<div class="animate__animated animate__fadeIn" style="min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 2rem;">
  <div class="glass-card" style="width: 100%; max-width: 450px; padding: 3rem 2rem;">
    <div style="text-align: center; margin-bottom: 2rem;">
      <div style="font-size: 3rem; margin-bottom: 1rem;">✉️</div>
      <h1 style="font-family: 'Playfair Display', serif; font-size: 2.2rem; color: var(--primary); margin-bottom: 0.5rem;">Verifica tu Cuenta</h1>
      <p style="color: var(--text-muted);">Hemos enviado un código OTP a tu correo electrónico. Por favor, ingrésalo a continuación.</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #ef4444; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; text-align: center; font-weight: 600;">
        <%= error %>
      </div>
    <% } %>

    <form method="POST" action="/verificar" style="display: flex; flex-direction: column; gap: 1.5rem;">
      <div>
        <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: var(--text-main); text-align: center;">Código de 6 dígitos</label>
        <input type="text" name="otp" required placeholder="123456" maxlength="6"
          style="width: 100%; padding: 1rem; border-radius: 8px; border: 1px solid rgba(150, 150, 150, 0.3); background: var(--bg-color); color: var(--text-main); outline: none; transition: border-color 0.3s; text-align: center; font-size: 1.5rem; letter-spacing: 0.5rem; font-weight: bold;"
          onfocus="this.style.borderColor='var(--primary)'" onblur="this.style.borderColor='rgba(150, 150, 150, 0.3)'">
      </div>

      <button type="submit" class="nav-btn" style="width: 100%; padding: 1rem; font-size: 1.1rem; margin-top: 1rem; border: none; cursor: pointer; text-align: center;">
        Verificar Cuenta
      </button>
    </form>

    <div style="text-align: center; margin-top: 2rem; border-top: 1px solid var(--glass-border); padding-top: 1.5rem;">
      <p style="color: var(--text-muted);">Si tienes problemas, <a href="/contacto" style="color: var(--primary); font-weight: 600; text-decoration: none;">contáctanos</a>.</p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
