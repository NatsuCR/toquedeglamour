<%- include('partials/header') %>
<%
  const s = siteSettings || {};
  const heroSlides = Array.isArray(s.heroSlides) && s.heroSlides.length
    ? s.heroSlides
    : [{
      image: s.heroImageUrl || '/img/beauty-hero.png',
      eyebrow: s.heroEyebrow,
      title: s.heroTitle,
      text: s.heroText
    }];
  const firstSlide = heroSlides[0];
%>

<section class="store-hero animate__animated animate__fadeIn" data-hero-slider>
  <div class="hero-slide-track" data-hero-track>
    <% heroSlides.forEach((slide) => { %>
      <div class="hero-slide" data-hero-image="<%= slide.image %>"
        data-hero-eyebrow="<%= slide.eyebrow %>" data-hero-title="<%= slide.title %>"
        data-hero-text="<%= slide.text %>" style="--hero-bg: url('<%= slide.image %>')"></div>
    <% }) %>
  </div>

  <div class="hero-copy">
    <p class="hero-eyebrow" data-hero-copy-eyebrow><%= firstSlide.eyebrow %></p>
    <h1 data-hero-copy-title><%= firstSlide.title %></h1>
    <p data-hero-copy-text><%= firstSlide.text %></p>
    <div class="hero-actions">
      <a href="<%= s.heroPrimaryHref || '/catalogo' %>" class="nav-btn"><%= s.heroPrimaryLabel %></a>
      <a href="<%= s.heroSecondaryHref || '/quienes-somos' %>" class="nav-btn-outline"><%= s.heroSecondaryLabel %></a>
    </div>

    <div class="hero-service-row" aria-label="Servicios principales">
      <span>Retiro local</span>
      <span>Correos de Costa Rica</span>
      <span>Pagos SINPE y BN</span>
    </div>
  </div>

  <button
    class="hero-zoom-btn"
    type="button"
    data-hero-zoom
    data-lightbox-alt="Imagen de portada Toque de Glamour"
    aria-label="Ampliar imagen de portada"
  >
    Ampliar imagen
  </button>

  <% if (heroSlides.length > 1) { %>
    <button class="hero-arrow hero-arrow-left" type="button" data-hero-prev aria-label="Portada anterior">&lsaquo;</button>
    <button class="hero-arrow hero-arrow-right" type="button" data-hero-next aria-label="Portada siguiente">&rsaquo;</button>
    <div class="hero-dots" aria-label="Portadas disponibles">
      <% heroSlides.forEach((slide, index) => { %>
        <button type="button" class="<%= index === 0 ? 'is-active' : '' %>" data-hero-dot="<%= index %>" aria-label="Ver portada <%= index + 1 %>"></button>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="home-showcase">
  <%- include('partials/slider-section', {
    titulo: s.topTitle,
    subtitulo: s.topSubtitle,
    icono: '',
    items: topVentas,
    sliderId: 'sliderTop',
    mostrarBadge: false
  }) %>

  <%- include('partials/slider-section', {
    titulo: s.newTitle,
    subtitulo: s.newSubtitle,
    icono: '',
    items: nuevos,
    sliderId: 'sliderNuevos',
    mostrarBadge: true
  }) %>

  <%- include('partials/slider-section', {
    titulo: s.suggestedTitle,
    subtitulo: s.suggestedSubtitle,
    icono: '',
    items: sugeridos,
    sliderId: 'sliderSugeridos',
    mostrarBadge: false
  }) %>
</section>

<div class="home-more">
  <a href="/catalogo" class="ver-mas-btn">Ver mas productos</a>
</div>

<a
  class="whatsapp-float"
  href="https://wa.me/50685203998?text=Hola%2C%20tengo%20una%20consulta%20sobre%20Toque%20de%20Glamour."
  target="_blank"
  rel="noopener"
  aria-label="Consultar por WhatsApp con Toque de Glamour"
>
  <span class="whatsapp-float__mark" aria-hidden="true">WA</span>
  <span class="whatsapp-float__text">Consultas por WhatsApp</span>
</a>

<script src="/js/image-lightbox.js"></script>
<script src="/js/hero-slider.js"></script>
<script src="/js/client-slider.js"></script>

<%- include('partials/footer') %>
