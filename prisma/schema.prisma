generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model UsuarioAdmin {
  id           Int               @id @default(autoincrement())
  correo       String            @unique
  passwordHash String            @map("password_hash")
  rol          RolPersonal       @default(ADMINISTRADOR)
  creadoEn     DateTime          @default(now()) @map("creado_en")
  ventas       VentaPresencial[]
  mermas       MermaInventario[]

  @@map("usuario_admin")
}

enum RolPersonal {
  ADMINISTRADOR @map("administrador")
  EMPLEADO      @map("empleado")
}

model Cliente {
  id                  Int                @id @default(autoincrement())
  correo              String             @unique
  passwordHash        String             @map("password_hash")
  nombre              String
  apellidos           String
  cedula              String             @unique
  celular1            String             @map("celular_1")
  celular2            String?            @map("celular_2")
  aceptoTerminos      Boolean            @default(false) @map("acepto_terminos")
  aceptaPromociones   Boolean            @default(false) @map("acepta_promociones")
  terminosAceptadosEn DateTime?          @map("terminos_aceptados_en")
  versionTerminos     String?            @map("version_terminos")
  cuentaVerificada    Boolean            @default(false) @map("cuenta_verificada")
  codigoVerificacion  String?            @map("codigo_verificacion")
  codigoExpiracion    DateTime?          @map("codigo_expiracion")
  codigoRecuperacion  String?            @map("codigo_recuperacion")
  recuperacionExpira  DateTime?          @map("recuperacion_expira")
  creadoEn            DateTime           @default(now()) @map("creado_en")
  bienvenidaUsadaEn   DateTime?          @map("bienvenida_usada_en")
  pedidos             Pedido[]
  direcciones         DireccionCliente[]
  tickets             TicketSoporte[]
  resenas             ResenaProducto[]

  @@map("clientes")
}

model Categoria {
  id            Int            @id @default(autoincrement())
  nombre        String
  slug          String         @unique
  descripcion   String?        @db.Text
  creadoEn      DateTime       @default(now()) @map("creado_en")
  productos     Producto[]
  subcategorias Subcategoria[]

  @@map("categorias")
}

model Subcategoria {
  id          Int        @id @default(autoincrement())
  categoriaId Int        @map("categoria_id")
  categoria   Categoria  @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  nombre      String
  slug        String     @unique
  descripcion String?    @db.Text
  creadoEn    DateTime   @default(now()) @map("creado_en")
  productos   Producto[]

  @@map("subcategorias")
}

enum TipoVentaProducto {
  DIRECTA  @map("directa")
  CONSULTA @map("consulta")
}

enum TipoProducto {
  GENERAL   @map("general")
  COSMETICO @map("cosmetico")
}

model Producto {
  id                    Int                   @id @default(autoincrement())
  categoriaId           Int                   @map("categoria_id")
  categoria             Categoria             @relation(fields: [categoriaId], references: [id])
  subcategoriaId        Int?                  @map("subcategoria_id")
  subcategoria          Subcategoria?         @relation(fields: [subcategoriaId], references: [id], onDelete: SetNull)
  nombre                String
  marca                 String?
  slug                  String                @unique
  descripcion           String                @db.Text
  modoUso               String?               @map("modo_uso") @db.Text
  detallesTecnicos      String?               @map("detalles_tecnicos") @db.Text
  precauciones          String?               @db.Text
  incluyePrecauciones   Boolean               @default(true) @map("incluye_precauciones")
  sostenibilidad        String?               @db.Text
  incluyeSostenibilidad Boolean               @default(false) @map("incluye_sostenibilidad")
  resultadosComprobados String?               @map("resultados_comprobados") @db.Text
  precio                Decimal?              @db.Decimal(10, 2)
  costo                 Decimal               @default(0.00) @db.Decimal(10, 2)
  stock                 Int                   @default(0)
  pesoGramos            Int                   @default(250) @map("peso_gramos")
  tipoVenta             TipoVentaProducto     @default(DIRECTA) @map("tipo_venta")
  tipoProducto          TipoProducto          @default(GENERAL) @map("tipo_producto")
  textoAlternativoImg   String                @map("texto_alternativo_img")
  creadoEn              DateTime              @default(now()) @map("creado_en")
  actualizadoEn         DateTime              @default(now()) @updatedAt @map("actualizado_en")
  esNuevo               Boolean               @default(false) @map("es_nuevo")
  fechaNuevo            DateTime?             @map("fecha_nuevo")
  promocionActiva       Boolean               @default(false) @map("promocion_activa")
  promocionPorcentaje   Int                   @default(0) @map("promocion_porcentaje")
  imagenes              ImagenProducto[]
  itemsPedido           ItemPedido[]
  itemsVentaPresencial  ItemVentaPresencial[]
  vistas                VistaProducto[]
  mermas                MermaInventario[]
  resenas               ResenaProducto[]
  preguntasFrecuentes   PreguntaFrecuente[]

  @@map("productos")
}

model ImagenProducto {
  id         Int      @id @default(autoincrement())
  productoId Int      @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  ruta       String
  principal  Boolean  @default(false)

  @@map("imagenes_producto")
}

enum EstadoPedido {
  PENDIENTE_VERIFICACION @map("pendiente_verificacion")
  PAGO_CONFIRMADO        @map("pago_confirmado")
  EN_PREPARACION         @map("en_preparacion")
  ENVIADO                @map("enviado")
  ENTREGADO              @map("entregado")
  RECHAZADO              @map("rechazado")
}

enum MetodoPago {
  DEPOSITO @map("deposito")
  SINPE    @map("sinpe")
}

enum CanalComprobante {
  WEB      @map("web")
  WHATSAPP @map("whatsapp")
}

enum TipoEntrega {
  LOCAL     @map("local")
  DOMICILIO @map("domicilio")
}

enum FasePedido {
  PREPARACION @map("preparacion")
  LISTO       @map("listo")
  ENVIADO     @map("enviado")
  COMPLETADO  @map("completado")
}

model Pedido {
  id                  Int              @id @default(autoincrement())
  codigo              String?          @unique
  clienteId           Int              @map("cliente_id")
  cliente             Cliente          @relation(fields: [clienteId], references: [id])
  nombreCliente       String?          @map("nombre_cliente")
  apellidosCliente    String?          @map("apellidos_cliente")
  correoCliente       String?          @map("correo_cliente")
  cedulaCliente       String?          @map("cedula_cliente")
  celular1Cliente     String?          @map("celular_1_cliente")
  celular2Cliente     String?          @map("celular_2_cliente")
  subtotal            Decimal          @default(0.00) @db.Decimal(10, 2)
  subtotalOriginal    Decimal          @default(0.00) @map("subtotal_original") @db.Decimal(10, 2)
  descuentoProducto   Decimal          @default(0.00) @map("descuento_producto") @db.Decimal(10, 2)
  descuentoBienvenida Decimal          @default(0.00) @map("descuento_bienvenida") @db.Decimal(10, 2)
  ivaIncluido         Decimal          @default(0.00) @map("iva_incluido") @db.Decimal(10, 2)
  costoEnvio          Decimal          @default(0.00) @map("costo_envio") @db.Decimal(10, 2)
  pesoTotalGramos     Int              @default(0) @map("peso_total_gramos")
  total               Decimal          @db.Decimal(10, 2)
  estado              EstadoPedido
  fase                FasePedido       @default(PREPARACION)
  tipoEntrega         TipoEntrega      @default(LOCAL) @map("tipo_entrega")
  metodoPago          MetodoPago       @map("metodo_pago")
  canalComprobante    CanalComprobante @map("canal_comprobante")
  motivoCancelacion   String?          @map("motivo_cancelacion") @db.Text
  canceladoEn         DateTime?        @map("cancelado_en")
  creadoEn            DateTime         @default(now()) @map("creado_en")
  actualizadoEn       DateTime         @updatedAt @map("actualizado_en")
  items               ItemPedido[]
  direccionEnvio      DireccionEnvio?
  comprobantePago     ComprobantePago?

  @@map("pedidos")
}

model ItemPedido {
  id                 Int      @id @default(autoincrement())
  pedidoId           Int      @map("pedido_id")
  pedido             Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoId         Int      @map("producto_id")
  producto           Producto @relation(fields: [productoId], references: [id])
  cantidad           Int
  precioUnitario     Decimal  @map("precio_unitario") @db.Decimal(10, 2)
  precioOriginal     Decimal  @default(0.00) @map("precio_original") @db.Decimal(10, 2)
  descuentoTotal     Decimal  @default(0.00) @map("descuento_total") @db.Decimal(10, 2)
  costoUnitario      Decimal  @default(0.00) @map("costo_unitario") @db.Decimal(10, 2)
  pesoUnitarioGramos Int      @default(0) @map("peso_unitario_gramos")

  @@map("items_pedido")
}

model ResenaProducto {
  id             Int      @id @default(autoincrement())
  productoId     Int      @map("producto_id")
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  clienteId      Int?     @map("cliente_id")
  cliente        Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  nombre         String
  comentario     String   @db.Text
  calificacion   Int
  creadaPorAdmin Boolean  @default(false) @map("creada_por_admin")
  fuenteOficial  Boolean  @default(false) @map("fuente_oficial")
  fuenteNombre   String?  @map("fuente_nombre")
  fuenteUrl      String?  @map("fuente_url") @db.VarChar(500)
  fechaOriginal  DateTime? @map("fecha_original")
  respuestaAdmin String?  @map("respuesta_admin") @db.Text
  respondidaEn   DateTime? @map("respondida_en")
  creadoEn       DateTime @default(now()) @map("creado_en")

  @@index([productoId, creadoEn])
  @@map("resenas_producto")
}

model PreguntaFrecuente {
  id         Int      @id @default(autoincrement())
  productoId Int      @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  pregunta   String
  respuesta  String   @db.Text
  creadoEn   DateTime @default(now()) @map("creado_en")

  @@index([productoId, creadoEn])
  @@map("preguntas_frecuentes_producto")
}

model DireccionEnvio {
  id              Int     @id @default(autoincrement())
  pedidoId        Int     @unique @map("pedido_id")
  pedido          Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  provincia       String
  canton          String
  distrito        String
  zonaEntrega     String? @map("zona_entrega")
  codigoPostal    String  @map("codigo_postal")
  direccionExacta String  @map("direccion_exacta") @db.Text
  descripcionCasa String? @map("descripcion_casa") @db.Text
  linkGoogleMaps  String? @map("link_google_maps")

  @@map("direcciones_envio")
}

model ComprobantePago {
  id                 Int     @id @default(autoincrement())
  pedidoId           Int     @unique @map("pedido_id")
  pedido             Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  rutaArchivo        String? @map("ruta_archivo")
  enviadoPorWhatsapp Boolean @default(false) @map("enviado_por_whatsapp")

  @@map("comprobantes_pago")
}

model DireccionCliente {
  id              Int      @id @default(autoincrement())
  clienteId       Int      @map("cliente_id")
  cliente         Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  provincia       String
  canton          String
  distrito        String
  zonaEntrega     String?  @map("zona_entrega")
  direccionExacta String   @map("direccion_exacta") @db.Text
  descripcionCasa String?  @map("descripcion_casa") @db.Text
  celular1        String   @map("celular_1")
  celular2        String?  @map("celular_2")
  creadoEn        DateTime @default(now()) @map("creado_en")

  @@map("direcciones_cliente")
}

enum EstadoTicket {
  ABIERTO @map("abierto")
  CERRADO @map("cerrado")
}

enum AutorMensajeTicket {
  CLIENTE @map("cliente")
  ADMIN   @map("admin")
}

model TicketSoporte {
  id            Int             @id @default(autoincrement())
  clienteId     Int             @map("cliente_id")
  cliente       Cliente         @relation(fields: [clienteId], references: [id])
  asunto        String
  estado        EstadoTicket    @default(ABIERTO)
  creadoEn      DateTime        @default(now()) @map("creado_en")
  actualizadoEn DateTime        @updatedAt @map("actualizado_en")
  mensajes      MensajeTicket[]

  @@map("tickets_soporte")
}

model MensajeTicket {
  id       Int                @id @default(autoincrement())
  ticketId Int                @map("ticket_id")
  ticket   TicketSoporte      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  autor    AutorMensajeTicket
  mensaje  String             @db.Text
  creadoEn DateTime           @default(now()) @map("creado_en")
  adjuntos AdjuntoTicket[]

  @@map("mensajes_ticket")
}

model AdjuntoTicket {
  id             Int           @id @default(autoincrement())
  mensajeId      Int           @map("mensaje_id")
  mensaje        MensajeTicket @relation(fields: [mensajeId], references: [id], onDelete: Cascade)
  rutaArchivo    String        @map("ruta_archivo")
  nombreOriginal String        @map("nombre_original")
  mimeType       String        @map("mime_type")
  tamanoBytes    Int           @map("tamano_bytes")
  creadoEn       DateTime      @default(now()) @map("creado_en")

  @@map("adjuntos_ticket")
}

model VistaProducto {
  id         Int      @id @default(autoincrement())
  productoId Int      @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  fecha      DateTime @default(now())
  clienteId  Int?     @map("cliente_id")
  ipHash     String?  @map("ip_hash")

  @@map("vistas_producto")
}

model AjusteSitio {
  id            Int      @id @default(autoincrement())
  clave         String   @unique
  valor         String   @db.Text
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("ajustes_sitio")
}

model GastoAdicional {
  id                Int      @id @default(autoincrement())
  fecha             DateTime @default(now())
  categoria         String   @default("General")
  descripcion       String   @db.Text
  monto             Decimal  @db.Decimal(10, 2)
  comprobanteRuta   String?  @map("comprobante_ruta")
  comprobanteNombre String?  @map("comprobante_nombre")
  comprobanteMime   String?  @map("comprobante_mime")
  creadoEn          DateTime @default(now()) @map("creado_en")

  @@map("gastos_adicionales")
}

model MermaInventario {
  id            Int          @id @default(autoincrement())
  productoId    Int          @map("producto_id")
  producto      Producto     @relation(fields: [productoId], references: [id])
  registradoPor Int          @map("registrado_por")
  administrador UsuarioAdmin @relation(fields: [registradoPor], references: [id])
  cantidad      Int
  costoUnitario Decimal      @map("costo_unitario") @db.Decimal(10, 2)
  montoPerdida  Decimal      @map("monto_perdida") @db.Decimal(10, 2)
  motivo        String       @db.Text
  creadoEn      DateTime     @default(now()) @map("creado_en")

  @@index([creadoEn])
  @@index([productoId])
  @@map("mermas_inventario")
}

enum MetodoPagoPresencial {
  EFECTIVO
  SINPE
  TARJETA
  TRANSFERENCIA
  OTRO
}

model VentaPresencial {
  id            Int                      @id @default(autoincrement())
  codigo        String                   @unique
  vendedorId    Int                      @map("vendedor_id")
  vendedor      UsuarioAdmin             @relation(fields: [vendedorId], references: [id])
  clienteNombre String?                  @map("cliente_nombre")
  clienteCorreo String?                  @map("cliente_correo")
  clienteCedula String?                  @map("cliente_cedula")
  metodoPago    MetodoPagoPresencial     @map("metodo_pago")
  subtotal      Decimal                  @db.Decimal(10, 2)
  iva           Decimal                  @default(0.00) @db.Decimal(10, 2)
  total         Decimal                  @db.Decimal(10, 2)
  comision      Decimal                  @default(0.00) @db.Decimal(10, 2)
  notas         String?                  @db.Text
  creadoEn      DateTime                 @default(now()) @map("creado_en")
  items         ItemVentaPresencial[]
  adjuntos      AdjuntoVentaPresencial[]

  @@map("ventas_presenciales")
}

model ItemVentaPresencial {
  id             Int             @id @default(autoincrement())
  ventaId        Int             @map("venta_id")
  venta          VentaPresencial @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId     Int             @map("producto_id")
  producto       Producto        @relation(fields: [productoId], references: [id])
  cantidad       Int
  precioUnitario Decimal         @map("precio_unitario") @db.Decimal(10, 2)
  costoUnitario  Decimal         @default(0.00) @map("costo_unitario") @db.Decimal(10, 2)

  @@map("items_venta_presencial")
}

model AdjuntoVentaPresencial {
  id       Int             @id @default(autoincrement())
  ventaId  Int             @map("venta_id")
  venta    VentaPresencial @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  ruta     String
  nombre   String
  mime     String
  creadoEn DateTime        @default(now()) @map("creado_en")

  @@map("adjuntos_venta_presencial")
}

model VisitaSitio {
  id                Int               @id @default(autoincrement())
  visitanteId       String            @map("visitante_id") @db.VarChar(64)
  sesionClave       String            @unique @map("sesion_clave") @db.VarChar(64)
  esAdministrativa  Boolean           @default(false) @map("es_administrativa")
  iniciadoEn        DateTime          @default(now()) @map("iniciado_en")
  ultimaActividadEn DateTime          @updatedAt @map("ultima_actividad_en")
  eventos           EventoAnalitica[]

  @@index([visitanteId])
  @@index([iniciadoEn])
  @@map("visitas_sitio")
}

model EventoAnalitica {
  id       Int         @id @default(autoincrement())
  visitaId Int         @map("visita_id")
  visita   VisitaSitio @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  tipo     String      @db.VarChar(20)
  ruta     String      @db.VarChar(255)
  destino  String?     @db.VarChar(255)
  etiqueta String?     @db.VarChar(160)
  creadoEn DateTime    @default(now()) @map("creado_en")

  @@index([tipo, creadoEn])
  @@index([ruta])
  @@map("eventos_analitica")
}
